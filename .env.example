# ── Site ──────────────────────────────────────────────
# Public base URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://lumenrealty.ae
# Keep "false" on staging. Set "true" only on the approved production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Lead storage ──────────────────────────────────────
# SQLite file for enquiries. MUST be on persistent storage (a mounted volume) in production.
LEADS_DB_PATH=/data/leads.db
# Max enquiries per IP per 10 minutes.
LEADS_RATE_LIMIT=5

# ── Admin (lead inbox at /admin/leads) ────────────────
# Leave empty to disable the admin area entirely. Use a long random password.
ADMIN_USER=
ADMIN_PASSWORD=

# ── CRM forwarding ────────────────────────────────────
# none | webhook | odoo   (default: none — leads are stored locally only)
CRM_PROVIDER=none

# webhook: POSTs each lead as JSON. Signed with HMAC-SHA256 in x-lumen-signature.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# odoo: creates crm.lead records via JSON-RPC. Use a dedicated API user with CRM rights only.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# ── Testing only — never set in production ────────────
# LUMEN_FIXTURES=1
